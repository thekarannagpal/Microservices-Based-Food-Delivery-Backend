{
  "name": "nexvia-food-delivery",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven microservices food delivery backend",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "libs/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "tsx --test libs/shared/test/saga.test.ts libs/shared/test/tracing.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/microservices": "^12.5.1",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.5.1",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^9.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
